{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/always-on-skills.sh\"",
            "timeout": 15,
            "statusMessage": "Loading always-on skills..."
          }
        ]
      }
    ]
  }
}
